{
  "name": "mdj-studio",
  "private": true,
  "version": "1.0.0",
  "description": "MDJ Studio - Markdown Jot Studio - Read. Write. Expand.",
  "author": "Martin Jalaf",
  "repository": {
    "type": "git",
    "url": "https://github.com/mjalaf/MDJ-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/mjalaf/MDJ-Studio/issues"
  },
  "homepage": "https://github.com/mjalaf/MDJ-Studio#readme",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "web": "vite",
    "electron:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:build-ts": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "electron:build": "npm run build && npm run electron:build-ts && electron-builder",
    "electron:dist": "npm run build && npm run electron:build-ts && electron-builder --win --publish never -c.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.42.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.mdjstudio.app",
    "productName": "MDJ Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "MDJ-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MDJ Studio"
    },
    "mac": {
      "icon": "public/icon.png"
    },
    "linux": {
      "icon": "public/icon.png"
    }
  }
}
